{
  "name": "boardgame-rules",
  "version": "1.0.0",
  "private": true,
  "description": "桌游规则书 — 纯静态站点，本地预览用 npm start",
  "scripts": {
    "start": "serve -l 18080 .",
    "dev:burgundy": "vite serve src/play/burgundy",
    "build:burgundy": "vite build src/play/burgundy",
    "test:burgundy": "vitest run -r src/play/burgundy",
    "typecheck:burgundy": "tsc -p src/play/burgundy",
    "check:data-burgundy": "node src/play/burgundy/src/engine/data/check.mjs"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
